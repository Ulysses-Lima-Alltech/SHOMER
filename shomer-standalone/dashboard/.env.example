# SHOMER Dashboard — copie para .env.local e ajuste conforme o ambiente
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_INGESTION_URL=http://localhost:3001

# URL do serviço edge (câmera), usada só para buscar o snapshot de fundo do
# mapa de calor. Só funciona se o navegador conseguir alcançar essa URL —
# ok na validação local (dashboard e edge na mesma rede); numa implantação
# remota (edge na rede do cliente, dashboard fora) isso não vai funcionar
# direto, precisa de um proxy/túnel. Deixe em branco pra esconder o
# snapshot e mostrar só a grade de calor.
NEXT_PUBLIC_EDGE_URL=http://localhost:8000
