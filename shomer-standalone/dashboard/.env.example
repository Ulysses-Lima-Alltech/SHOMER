# SHOMER Dashboard — copie para .env.local e ajuste conforme o ambiente
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_INGESTION_URL=http://localhost:3001

# O snapshot de fundo do mapa de calor não usa mais URL direta pro edge
# (o navegador do cliente nunca alcança a rede local de quem roda o edge).
# A API agora proxeia isso em GET /stats/snapshot - configure
# EDGE_SNAPSHOT_URL no .env da API (ver api/.env.example).
