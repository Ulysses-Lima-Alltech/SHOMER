# SHOMER API — copie para .env e ajuste conforme o ambiente

PORT=3000
CORS_ORIGIN=http://localhost:3002

# Postgres — porta 15432 porque infra/docker-compose.yml remapeia a porta
# do host (5432 colidia com um Postgres nativo na máquina de dev original)
DATABASE_URL=postgresql://shomer:shomer_dev@localhost:15432/shomer

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=shomer
CLICKHOUSE_PASSWORD=shomer_dev
CLICKHOUSE_DATABASE=shomer

# Tenant padrão usado nos endpoints de /stats quando o usuário logado é
# super_admin e não passa ?tenantId= na query (super_admin não tem tenant
# próprio — usuários tenant_admin/viewer sempre usam o próprio tenant,
# ignorando este valor). Precisa bater com TENANT_ID configurado no edge/.env
# do cliente correspondente.
STATS_TENANT_ID=demo-tenant-id

# Fuso horário da loja, usado para calcular "hoje"/hora nos endpoints de
# /stats (o ClickHouse roda em UTC por padrão).
STATS_TIMEZONE=America/Sao_Paulo

# Usuário super_admin (acesso global, cria clientes/tenants e demais
# acessos) criado por `npm run seed`. Também garante que o tenant demo
# exista (id "demo-tenant-id", igual ao STATS_TENANT_ID acima).
SEED_ADMIN_EMAIL=admin@shomer.com
SEED_ADMIN_PASSWORD=admin123

# Layout das câmeras do edge, usado por GET /stats/cameras|snapshot|camera-status
# (mapa de calor e aba de validação ao vivo) - a API roda na mesma máquina
# que os processos do edge, então localhost funciona aqui mesmo com o
# dashboard hospedado fora (o navegador do cliente nunca alcançaria isso
# direto). Deixe em branco para usar o layout fixo padrão (4 câmeras do
# tenant 1005, ver DEFAULT_EDGE_CAMERAS em stats.controller.ts) - só
# defina isso se o layout de câmeras mudar ou outro tenant precisar de um
# conjunto diferente:
# EDGE_CAMERAS=[{"id":"camera-04","label":"Joias","url":"http://localhost:8003"}]
