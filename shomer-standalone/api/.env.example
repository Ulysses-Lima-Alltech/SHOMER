# SHOMER API — copie para .env e ajuste conforme o ambiente

PORT=3000
CORS_ORIGIN=http://localhost:3002

# Postgres (ver shomer-standalone/infra/docker-compose.yml)
DATABASE_URL=postgresql://shomer:shomer_dev@localhost:5432/shomer

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=shomer
CLICKHOUSE_PASSWORD=shomer_dev
CLICKHOUSE_DATABASE=shomer

# Tenant único consultado pelos endpoints de /stats (MVP single-tenant).
# Precisa bater com TENANT_ID configurado no edge/.env
STATS_TENANT_ID=demo-tenant-id

# Usuário admin criado por `npm run seed`
SEED_ADMIN_EMAIL=admin@shomer.com
SEED_ADMIN_PASSWORD=admin123
