# SHOMER Edge Service — copie para .env e ajuste conforme o ambiente

# mock: gera eventos sintéticos (person.detected, demographics.estimated,
#       edge.health.reported) e envia para o ingestion, sem precisar de câmera.
# production: liga a câmera de verdade e roda YOLOv8 + ByteTrack + line crossing.
MODE=mock

API_URL=http://localhost:3000
INGESTION_URL=http://localhost:3001

# --- Câmera / visão computacional (apenas MODE=production) ---
# Opção A: informe a URL RTSP pronta (funciona para qualquer marca/modelo)
CAMERA_SOURCE=0
RTSP_URL=

# Opção B: câmera/DVR/NVR Intelbras — informe só IP + credenciais e a URL
# RTSP é montada automaticamente (formato "cam/realmonitor", padrão OEM
# Dahua usado pelas Intelbras). Ignorado se CAMERA_SOURCE/RTSP_URL estiver
# preenchido. Use scripts/test_camera_connection.py para validar antes de
# rodar o worker completo.
CAMERA_INTELBRAS_HOST=
CAMERA_INTELBRAS_USER=admin
CAMERA_INTELBRAS_PASSWORD=
CAMERA_INTELBRAS_PORT=554
# Canal do DVR/NVR (1 = primeira câmera). Para câmera IP standalone, use 1.
CAMERA_INTELBRAS_CHANNEL=1
# 0 = mainstream (resolução cheia), 1 = substream (mais leve, recomendado
# para detecção contínua se o mainstream causar lag/CPU alta)
CAMERA_INTELBRAS_SUBTYPE=0

FFMPEG_PATH=ffmpeg
YOLO_MODEL=yolov8n.pt
# 0.5 e o padrao seguro. Em cameras com gente perto da borda do quadro,
# pouca luz ou muita oclusao (araras de roupa, vitrines), pessoas reais
# ficam abaixo do limiar e nao sao detectadas - baixar para 0.35-0.4
# recupera esses casos, ao custo de mais falsos positivos passageiros
# (o filtro de objeto estatico do line_crossing.py contem a maioria).
YOLO_CONFIDENCE=0.5
YOLO_IMAGE_SIZE=640
# bytetrack.yaml e o default do Ultralytics (track_buffer=30 frames). Em
# cenas com gente se cruzando/ocluindo por 1-2s, isso faz o tracker abrir
# um track_id novo ao inves de reconhecer a mesma pessoa, inflando
# contagem de detected/duplicando cruzamento de linha. config/tracker_shomer.yaml
# (neste repo) aumenta track_buffer pra 90 frames - segura a track "viva"
# esperando a pessoa reaparecer antes de desistir. Recomendado em producao:
# YOLO_TRACKER=config/tracker_shomer.yaml (caminho absoluto tambem funciona)
YOLO_TRACKER=bytetrack.yaml
VISION_FPS=5.0
CAMERA_RECONNECT_SECONDS=5.0
CAMERA_RECONNECT_MAX_SECONDS=60.0

# Pausa o processamento fora do horário de funcionamento configurado no
# dashboard (Configurações → Horário de funcionamento) — economiza CPU/GPU
# fora do expediente. Precisa de TENANT_ID e API_URL corretos; busca o
# horário periodicamente num endpoint público (sem autenticação).
BUSINESS_HOURS_CHECK_ENABLED=false
BUSINESS_HOURS_POLL_INTERVAL_SECONDS=300.0

# --- Line crossing (contagem de entrada/saída por linha virtual) ---
LINE_CROSSING_ENABLED=true
LINE_CROSSING_LINE_ID=main
LINE_CROSSING_X1=0.0
LINE_CROSSING_Y1=0.5
LINE_CROSSING_X2=1.0
LINE_CROSSING_Y2=0.5
LINE_CROSSING_ENTER_DIRECTION=A_TO_B
LINE_CROSSING_TOLERANCE=0.02
LINE_CROSSING_COOLDOWN_SECONDS=1.0
LINE_CROSSING_TRACK_TTL_SECONDS=15.0

# Publicação de eventos person.line_crossed para o ingestion (MODE=production)
CROSSING_EVENTS_ENABLED=false
# Publicação de eventos person.detected (um por track_id a cada N segundos,
# alimenta "visitantes hoje"/"pico do dia" e o mapa de calor com detecções
# reais — cada evento carrega floorPoint, a posição normalizada dos pés da
# pessoa no enquadramento da câmera)
DETECTION_EVENTS_ENABLED=false
DETECTION_EVENTS_MIN_INTERVAL_SECONDS=3.0
# Publicação periódica de edge.health.reported, independente das duas acima
# — alimenta a tela Monitoramento do dashboard (câmera conectada, modelo
# pronto, último erro) mesmo sem eventos de detecção/crossing habilitados
EDGE_HEALTH_REPORT_ENABLED=false
EDGE_HEALTH_REPORT_INTERVAL_SECONDS=30.0
EVENT_QUEUE_MAX_SIZE=1000
EVENT_PUBLISH_MAX_ATTEMPTS=3
EVENT_PUBLISH_RETRY_BASE_SECONDS=0.5
EVENT_PUBLISH_RETRY_MAX_SECONDS=5.0
EVENT_PUBLISH_DRAIN_TIMEOUT_SECONDS=5.0

# --- Identificação do dispositivo / loja ---
# Precisa bater com STATS_TENANT_ID no api/.env e EDGE_DEVICES no ingestion/.env
TENANT_ID=demo-tenant-id
STORE_ID=store-centro
CAMERA_ID=camera-01
EDGE_DEVICE_ID=test-device-id
DEVICE_KEY=test-device-key
