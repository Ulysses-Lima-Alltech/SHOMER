# SHOMER Ingestion Service — copie para .env e ajuste conforme o ambiente

PORT=3001

# ClickHouse (ver shomer-standalone/infra/docker-compose.yml)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=shomer
CLICKHOUSE_PASSWORD=shomer_dev
CLICKHOUSE_DATABASE=shomer
CLICKHOUSE_EVENTS_TABLE=events

# Dispositivos edge autorizados a publicar eventos (MVP — ver device-auth.guard.ts).
# Formato: "deviceId1:deviceKey1,deviceId2:deviceKey2"
# Precisa bater com EDGE_DEVICE_ID / DEVICE_KEY configurados no edge/.env
EDGE_DEVICES=test-device-id:test-device-key
